# 复制为 terraform.tfvars 并按需修改
region           = "cn-hangzhou"

# studio（Flutter Web）桶与 CDN
bucket_name      = "qtcloud-execute-studio"
cdn_domain       = "studio.execute.cloud.quanttide.com"

# site（React+Vite 介绍页）桶与 CDN（原 studio 域，按惯例移交 site 承载）
site_bucket_name = "qtcloud-execute-site"
site_cdn_domain  = "execute.cloud.quanttide.com"

# provider（FC）
environment       = "prod"
oss_data_bucket  = "qtcloud-execute-provider"
oss_endpoint     = "oss-cn-hangzhou.aliyuncs.com"
image            = "<ACR实例公网地址>/quanttide/qtcloud-execute-provider:latest" # 敏感，勿入库；CI 用 TF_VAR_image 注入
# oss_access_key_id / oss_access_key_secret：provider 运行时访问 OSS 的 AK/SK，敏感，勿入库；CI 用 TF_VAR_* 注入
